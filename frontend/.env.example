# Base de l'API métier et d'authentification.
# Vide (défaut) = chemins relatifs, la gateway nginx route /api/v1 vers les APIs.
VITE_API_BASE_URL=

# URL du hub temps réel. Vide = « /ws » sur la même origine.
VITE_WS_URL=

# Développement uniquement : gateway vers laquelle Vite proxifie /api et /ws.
VITE_DEV_GATEWAY=https://localhost:8443
