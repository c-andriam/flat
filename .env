# --- Ajoute lors de l'audit backend ---
# Environnement : production active les controles stricts de configuration.
APP_ENV=production
LOG_LEVEL=INFO
# Cookies uniquement en HTTPS (le gateway force deja la redirection).
COOKIE_SECURE=true
FRONTEND_URL=https://localhost:8443
# A RENSEIGNER : emails promus admin a leur prochaine connexion SSO.
BOOTSTRAP_ADMIN_EMAILS=
# Pool par process : 6 conteneurs x (5+5) reste sous la limite du pooler Supabase.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Recyclage volontairement court : il remplace la sonde de vivacite ci-dessous
# en fermant les connexions bien avant que le pooler Supabase ne les coupe.
DB_POOL_RECYCLE=240
# Sonde « la connexion est-elle vivante ? » avant chaque emprunt au pool.
# Mesuree a ~780 ms par requete depuis Madagascar, soit environ la moitie du
# temps de reponse de l'API : /slots est passe de 1935 ms a 1130 ms de moyenne
# en la desactivant. Remettre a true si « server closed the connection
# unexpectedly » apparait dans les logs.
DB_POOL_PRE_PING=false
RELANCE_HORIZON_DAYS=3
RELANCE_COOLDOWN_DAYS=3
