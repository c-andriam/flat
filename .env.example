# =============================================================================
# Modèle de configuration — À COPIER EN `.env` PUIS REMPLIR
#
#     cp .env.example .env
#
# Ce fichier est versionné : il ne doit contenir QUE des valeurs factices.
# Toute valeur réelle écrite ici part sur GitHub et doit être considérée
# comme compromise dès le premier push.
# =============================================================================

# --- ENVIRONNEMENT ---
# `production` (défaut) active les contrôles stricts : refus de démarrer si
# SECRET_KEY est resté à une valeur d'exemple. `dev` les assouplit.
APP_ENV=dev
LOG_LEVEL=INFO

# --- INFRASTRUCTURE (Supabase Postgres) ---
POSTGRES_USER=postgres.xxxxxxxxxxxxxxxxxxxx
POSTGRES_PASSWORD=remplacer-par-le-mot-de-passe-supabase
POSTGRES_DB=postgres
POSTGRES_HOST=aws-0-eu-west-3.pooler.supabase.com
POSTGRES_PORT=5432

# Taille du pool par process. Chaque conteneur (3 APIs + 3 workers) ouvre son
# propre pool : garder POOL_SIZE x nombre de conteneurs sous la limite du
# pooler Supabase.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Sonde « la connexion est-elle encore vivante ? » avant chaque emprunt au
# pool. Elle protège des coupures du pooler Supabase, mais coûte un
# aller-retour complet : mesuré à ~780 ms par requête depuis Madagascar,
# soit la moitié du temps de réponse de l'API. Passer à false accélère
# nettement, au prix d'erreurs sporadiques si le pooler ferme une connexion
# inactive — à tester avant de le figer en production.
DB_POOL_PRE_PING=true

# Durée de mise en cache du profil d'un compte (rôle, activation), en
# secondes. Chaque requête relisait ce profil en base : un aller-retour
# complet, soit environ un tiers du temps de réponse. Les changements de rôle
# faits via l'API purgent l'entrée et prennent effet immédiatement ; ce délai
# ne concerne qu'une modification faite directement en base. Mettre 0 pour
# rétablir la relecture systématique.
AUTH_CACHE_TTL_SECONDS=30
DB_ECHO=false
# `require` pour Supabase (TLS obligatoire). Passer a `disable` pour une
# instance PostgreSQL locale, qui n'a pas de certificat — voir `make up-local`.
DB_SSL_MODE=require

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- SÉCURITÉ & JWT ---
# Générer une valeur unique par environnement :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cette clé signe tous les jetons applicatifs : si elle fuite, n'importe qui
# peut forger un jeton administrateur.
SECRET_KEY=generer-une-cle-de-48-octets-avec-secrets-token-urlsafe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookies transmis uniquement en HTTPS. Passer à false seulement sur un poste
# de développement servi en http://.
COOKIE_SECURE=true

# --- FRONTEND & CORS ---
# Cible de la redirection après le callback SSO : auth-api y renvoie le
# navigateur avec le jeton en fragment (`/#token=...`), que la SPA consomme.
# En développement avec `make front-dev`, mettre http://localhost:5173 —
# sinon le SSO renvoie vers la gateway et le serveur Vite ne reçoit rien.
FRONTEND_URL=https://localhost:8443
# Origines autorisées, séparées par des virgules. Vide = FRONTEND_URL seule.
CORS_ORIGINS=

# --- RBAC ---
# Amorçage des droits : ces adresses reçoivent le rôle `admin` à leur
# prochaine connexion SSO. Sans cette liste, le premier utilisateur arrive en
# `lecteur` et personne ne peut promouvoir personne (/users exige déjà admin).
BOOTSTRAP_ADMIN_EMAILS=prenom.nom@trimeta.mg

# Noms de responsables a ne jamais decouper. Le tiret separe deux personnes
# dans les classeurs (« Meylis-Hassen »), mais il fait partie de certains
# prenoms composes. Separer par des virgules.
RESPONSABLES_INSECABLES=

# --- MICROSOFT GRAPH & SSO (AZURE AD / ENTRA ID) ---
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_REDIRECT_URI=https://localhost:8443/api/v1/auth/callback
# --- SharePoint (acces fichiers, permissions d'application) ---
# Hote du tenant. Vide, l'integration fichiers reste inactive et l'import
# depuis un dossier local continue de fonctionner normalement.
SHAREPOINT_HOSTNAME=trimetagroup.sharepoint.com
# Chemin du site, ex. /sites/DSIO. Vide = site racine du tenant.
SHAREPOINT_SITE_PATH=/sites/DSIO
# Bibliotheque de documents. Vide = bibliotheque par defaut du site.
SHAREPOINT_DRIVE_NAME=
# Dossier contenant un sous-dossier par projet (« P01 - Cantine »).
SHAREPOINT_ROOT_FOLDER_PATH=07_Projets_DSIO/Projet encours/
#
# Permission requise dans Entra ID : une permission *d'application* sur les
# fichiers. Preferer `Sites.Selected`, accordee sur ce seul site, plutot que
# `Sites.Read.All` ou `Files.Read.All` qui ouvrent tous les sites du tenant a
# l'application. Verifier avec : make sharepoint-check

# Boite d'envoi des relances (permission d'application Mail.Send requise
# dans Entra ID). Sans elle, les emails sont seulement simules et le
# statut renvoye vaut `simulated` au lieu de `sent`.
GRAPH_SENDER_UPN=suivi-dsi@trimetagroup.mg
# Forcer la simulation meme si tout est configure (recette, formation).
EMAIL_DRY_RUN=false

# --- RELANCES ---
# Le moteur envoie a chaque responsable un recapitulatif unique, decoupe en
# sections (en retard / jour J / echeances proches / en attente). Sa cadence et
# son contenu appartiennent a chaque destinataire : voir la page /relances ou
# la table `relance_preferences`. Deux envois par semaine par defaut, le lundi
# et le jeudi a 8 h.
#
# Fenetre d'alerte par defaut : une action est signalee a partir de J-3.
# Chacun peut la redefinir dans ses preferences.
RELANCE_HORIZON_DAYS=3
# Delai minimal entre deux rappels *ponctuels* d'un meme responsable
# (`/relances/{id}/send`). Le recapitulatif planifie n'en depend pas : son
# garde-fou est « un seul envoi par jour ».
RELANCE_COOLDOWN_DAYS=3
# Fuseau dans lequel s'entendent les heures d'envoi choisies par les
# utilisateurs. Doit rester aligne sur celui du planificateur Celery : regler
# 8 h doit vouloir dire 8 h pour la personne, pas 8 h UTC (soit 11 h ici).
RELANCE_TIMEZONE=Indian/Antananarivo

# --- RATE LIMITING ---
# `memory://` (défaut) = compteur par process. Pour un compteur partagé entre
# réplicas : redis://redis:6379/1
RATELIMIT_STORAGE_URI=memory://
